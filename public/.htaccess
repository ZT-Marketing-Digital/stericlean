# SteriClean — configuração do Apache (cPanel/HostGator).
# Este arquivo é copiado pelo build para .output/public/ e sobe junto no deploy.

# ---------------------------------------------------------------------------
# Roteamento
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # O site atende em stericleanbrasil.com.br e www.stericleanbrasil.com.br.
  # Sem este 301 o mesmo conteúdo responde nos dois endereços e o Google
  # trata como conteúdo duplicado. A forma oficial é a sem www (é o que está
  # no canonical, no og:url e no sitemap.xml).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # %{REQUEST_SCHEME} preserva http/https: enquanto o AutoSSL não estiver
  # ativo, forçar https aqui quebraria quem chega pelo www.
  RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [L,R=301]

  # HTTPS: só ligue depois que o certificado (AutoSSL) estiver ativo no cPanel.
  # Ligar antes disso derruba o site.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Arquivos e pastas que existem no disco são servidos direto — inclusive o
  # /api/ em PHP do formulário, que não pode cair no fallback abaixo.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra rota devolve o index.html e o roteador do app resolve.
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Os arquivos em /assets/ têm hash no nome: mudou o conteúdo, mudou a URL.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # O HTML não pode ser cacheado: é ele que aponta para os assets novos.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---------------------------------------------------------------------------
# Compressão
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Diversos
# ---------------------------------------------------------------------------
AddDefaultCharset UTF-8
Options -Indexes

# Não expor o estado do FTP-Deploy-Action nem arquivos de configuração.
<FilesMatch "^(\.ftp-deploy-sync-state\.json|\.env.*|\.git.*)$">
  Require all denied
</FilesMatch>

# O endpoint do formulário grava contatos.log quando o envio de e-mail falha.
# Esse arquivo tem dado pessoal e não pode ser servido pela web.
<FilesMatch "\.log$">
  Require all denied
</FilesMatch>
